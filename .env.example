NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side AI integration only — never expose in Client Components.
# OPENAI_API_KEY is optional here; admin can configure via the platform UI instead.
OPENAI_API_KEY=

# Required for encrypting the OpenAI API key stored in the database.
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET=
