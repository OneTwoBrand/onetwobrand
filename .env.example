NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side AI integration only — never expose in Client Components.
# OPENAI_API_KEY is optional here; admin can configure via the platform UI instead.
OPENAI_API_KEY=

# Required for encrypting the OpenAI API key stored in the database.
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET=

# Signs the HTTP-only customer session used by the storefront account area.
# Generate with: openssl rand -hex 32 (ENCRYPTION_SECRET is used as fallback).
SHOP_SESSION_SECRET=

# Required for user management (invite, deactivate, delete).
# Never expose this key in client-side code.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the platform (used in invite email redirect).
NEXT_PUBLIC_SITE_URL=https://one2brand.com.br

# Resend API key for transactional emails (invite, account status).
# https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender address for transactional emails.
# Example: Convites ONE TWO <convites@one2brand.com.br>
RESEND_FROM=

# Payment providers. Webhook secrets must come from each provider dashboard.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Required by /api/shop/op-notify. Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# Local development only. Production always suppresses demonstrative records.
ALLOW_DEMO_DATA=false
